@model DashboardVm
@{
    ViewData["Title"] = "Overview";
    var isManagement = User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Supervisor);
}
<div class="page-heading">
    <div><div class="eyebrow">YOUR WORKSPACE AT A GLANCE</div><h1>Good to have you here, @User.Identity?.Name.</h1><p>Here's what matters across your @(isManagement ? "team" : "tasks") today.</p></div>
    <div class="heading-actions"><a class="btn light" asp-controller="Tasks" asp-action="Index">View all tasks ↗</a>@if(isManagement){<a class="btn primary" asp-controller="Tasks" asp-action="Create">+ New task</a>}</div>
</div>
<div class="metrics">
    <div class="metric-card"><div class="metric-icon blue">☷</div><div class="metric-number">@Model.Total</div><div class="metric-label">Total tasks</div><div class="metric-sub">Tasks in your scope</div></div>
    <div class="metric-card"><div class="metric-icon orange">↗</div><div class="metric-number">@Model.InProgress</div><div class="metric-label">In progress</div><div class="metric-sub">Work moving forward</div></div>
    <div class="metric-card"><div class="metric-icon teal">✓</div><div class="metric-number">@Model.AwaitingReview</div><div class="metric-label">Awaiting review</div><div class="metric-sub">Submitted for approval</div></div>
    <div class="metric-card"><div class="metric-icon red">!</div><div class="metric-number">@Model.Overdue</div><div class="metric-label">Past due</div><div class="metric-sub">Require attention</div></div>
</div>
<div class="content-grid">
    <section class="panel">
        <div class="panel-header"><div><div class="eyebrow">PRIORITY WATCH</div><h2>Upcoming work</h2></div><a asp-controller="Tasks" asp-action="Index" class="text-link">All tasks →</a></div>
        @if(Model.RecentTasks.Count == 0)
        {
            <div class="blank-inline"><strong>No tasks yet.</strong><p>Tasks will appear here when they are created or assigned.</p></div>
        }
        else
        {
            <div class="task-list">
                @foreach(var task in Model.RecentTasks)
                {
                    <a class="task-row" asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id">
                        <span class="task-bubble">☷</span><span class="task-title"><strong>@task.Title</strong><small>@(task.Engagement?.ClientName ?? "No engagement") · @(task.AssignedEmployee?.FullName ?? "Unassigned")</small></span>
                        <span class="status @task.Status.Replace(" ", "").ToLowerInvariant()">@task.Status</span>
                        <span class="task-date">@task.DueDate.ToString("dd MMM")</span><span class="chevron">→</span>
                    </a>
                }
            </div>
        }
    </section>
    <aside class="stack">
        <div class="feature-panel"><div class="feature-icon">✦</div><div class="eyebrow light">INTELLIGENT ALLOCATION</div><h2>Give every task the right match.</h2><p>Compare employee skills and current workload. A supervisor always confirms the final assignment.</p><a asp-controller="Tasks" asp-action="Index">Open task board →</a></div>
        <section class="panel compact"><div class="panel-header"><h2>Quick access</h2></div><div class="quick-links"><a asp-controller="Engagements" asp-action="Index">◫ <span>Client engagements</span> →</a>@if(isManagement){<a asp-controller="Employees" asp-action="Index">♧ <span>@Model.TeamSize team members</span> →</a><a asp-controller="Reviews" asp-action="Index">✓ <span>Review submissions</span> →</a>}else{<a asp-controller="Tasks" asp-action="Index">☷ <span>My assignments</span> →</a>}</div></section>
    </aside>
</div>
