@model List<WorkItem>
@{
    ViewData["Title"] = "Task management";
    var management = User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Supervisor);
}
<div class="page-heading"><div><div class="eyebrow">INTELLIGENT WORKFLOW</div><h1>@(management ? "Tasks, at every stage." : "Your tasks, at a glance.")</h1><p>Follow progress, deadlines and assignments from one workspace.</p></div>@if(management){<a class="btn primary" asp-action="Create">+ New task</a>}</div>
<div class="toolbar"><span class="count-pill">@Model.Count tasks</span><span class="muted">Select a task to open its details, progress and recommendations.</span></div>
<section class="panel"><div class="table-wrap"><table><thead><tr><th>Task</th><th>Engagement</th><th>Assigned to</th><th>Progress</th><th>Due date</th><th>Status</th><th></th></tr></thead><tbody>
@foreach(var task in Model){<tr>
<td><div class="task-name"><strong>@task.Title</strong><small><span class="priority @task.Priority.ToLowerInvariant()">● @task.Priority</span> · @task.Department</small></div></td>
<td>@(task.Engagement?.ClientName ?? "General")</td><td>@(task.AssignedEmployee?.FullName ?? "Unassigned")</td>
<td><div class="progress-cell"><div class="progress-track"><div style="width:@(task.Progress)%"></div></div><span>@task.Progress%</span></div></td>
<td>@task.DueDate.ToString("dd MMM yyyy")</td><td><span class="status @task.Status.Replace(" ", "").ToLowerInvariant()">@task.Status</span></td>
<td><a class="text-link" asp-action="Details" asp-route-id="@task.Id">Open →</a></td>
</tr>}
</tbody></table></div>
@if(Model.Count == 0){<div class="blank-inline"><strong>Nothing on the board yet.</strong><p>@(management ? "Create a task to start planning work." : "Your assigned work will appear here.")</p></div>}
</section>
