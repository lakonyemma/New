@model EmployeeForm
@{
    var editing = Model.Id.HasValue;
    ViewData["Title"] = editing ? "Edit employee" : "Add employee";
}
<div class="page-heading"><div><div class="eyebrow">TEAM / ACCOUNT MANAGEMENT</div><h1>@(editing ? "Edit employee details" : "Add someone to the team")</h1><p>@(editing ? "Update skills, hours, and availability." : "Create an employee record and their first sign-in account.")</p></div><a class="btn light" asp-action="Index">← Back to team</a></div>
<section class="panel form-panel"><form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id">
<div asp-validation-summary="ModelOnly" class="validation"></div><div class="form-grid">
<div class="field"><label asp-for="FullName">Full name</label><input asp-for="FullName" placeholder="e.g. Sarah Kato"/><span asp-validation-for="FullName" class="validation"></span></div>
<div class="field"><label asp-for="Email">Work email</label><input asp-for="Email" placeholder="name@example.com"/><span asp-validation-for="Email" class="validation"></span></div>
<div class="field"><label asp-for="Department"></label><input asp-for="Department"/><span asp-validation-for="Department" class="validation"></span></div>
<div class="field"><label asp-for="Skills">Skills (comma-separated)</label><input asp-for="Skills" placeholder="Audit, Accounting, Tax"/><span asp-validation-for="Skills" class="validation"></span></div>
<div class="field"><label asp-for="WeeklyHours">Weekly capacity (hours)</label><input asp-for="WeeklyHours" type="number" min="1" max="80" step="0.5"/><span asp-validation-for="WeeklyHours" class="validation"></span></div>
<div class="field check-field"><label><input asp-for="IsAvailable" /> Available for assignments</label></div>
@if(!editing){
<div class="form-separator">ACCOUNT ACCESS</div>
<div class="field"><label asp-for="UserName">Login username</label><input asp-for="UserName" autocomplete="off"/><span asp-validation-for="UserName" class="validation"></span></div>
<div class="field"><label asp-for="InitialPassword">Temporary password (12+ characters)</label><input asp-for="InitialPassword" autocomplete="new-password"/><span asp-validation-for="InitialPassword" class="validation"></span></div>
<div class="field"><label asp-for="Role">Access role</label><select asp-for="Role"><option value="Employee">Employee</option><option value="Supervisor">Supervisor</option></select><span asp-validation-for="Role" class="validation"></span></div>
}
</div><div class="form-actions"><a class="btn light" asp-action="Index">Cancel</a><button class="btn primary" type="submit">@(editing ? "Save changes" : "Create employee") →</button></div></form></section>
