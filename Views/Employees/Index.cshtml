@model List<Employee>
@{
    ViewData["Title"] = "Team & people";
}
<div class="page-heading"><div><div class="eyebrow">RESOURCE MANAGEMENT</div><h1>People make the difference.</h1><p>View skills, availability and weekly capacity across your team.</p></div>
@if(User.IsInRole(Roles.Administrator)){<a class="btn primary" asp-action="Create">+ Add employee</a>}</div>
<section class="panel"><div class="panel-header"><h2>Team directory <span class="count-pill">@Model.Count</span></h2><span class="muted">Skills & available capacity</span></div>
<div class="table-wrap"><table><thead><tr><th>Employee</th><th>Department</th><th>Skills</th><th>Capacity</th><th>Availability</th>@if(User.IsInRole(Roles.Administrator)){<th></th>}</tr></thead><tbody>
@foreach(var person in Model){<tr><td><div class="person-cell"><span class="avatar">@person.FullName.FirstOrDefault()</span><span><strong>@person.FullName</strong><small>@person.Email</small></span></div></td><td>@person.Department</td><td class="limited-text">@person.Skills</td><td>@person.WeeklyHours h/week</td><td><span class="status @(person.IsAvailable ? "completed" : "awaitingreview")">@(person.IsAvailable ? "Available" : "Unavailable")</span></td>@if(User.IsInRole(Roles.Administrator)){<td><a class="text-link" asp-action="Edit" asp-route-id="@person.Id">Edit →</a></td>}</tr>}
</tbody></table></div>
@if(Model.Count == 0){<div class="blank-inline">No employees have been added yet.</div>}
</section>
