@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var isManagement = User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Supervisor);
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>@ViewData["Title"] · Workwise</title>
    <link rel="stylesheet" asp-href-include="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(signedIn ? "app-shell" : "guest-shell")">
@if (signedIn)
{
    <aside class="sidebar">
        <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">W</span><span>WORKWISE<small>Khan Associates</small></span></a>
        <div class="nav-heading">WORKSPACE</div>
        <nav aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Index"><span>▦</span> Overview</a>
            <a asp-controller="Tasks" asp-action="Index"><span>☷</span> @(User.IsInRole(Roles.Employee) ? "My tasks" : "Task management")</a>
            <a asp-controller="Engagements" asp-action="Index"><span>◫</span> Engagements</a>
            @if (isManagement)
            {
                <a asp-controller="Employees" asp-action="Index"><span>♧</span> Team & people</a>
                <a asp-controller="Reviews" asp-action="Index"><span>✓</span> Review & approvals</a>
            }
        </nav>
        <div class="sidebar-bottom">
            <div class="mini-label">CURRENT WORKSPACE</div>
            <div class="workspace-mini"><span class="workspace-icon">KA</span><span>Khan Associates<small>Workload management</small></span></div>
        </div>
    </aside>
    <div class="main-shell">
        <header class="topbar">
            <button class="mobile-menu" type="button" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false">☰</button>
            <div class="crumb">WORKWISE <span>/</span> @ViewData["Title"]</div>
            <div class="top-right"><span class="live-dot"></span><span class="status-label">Workspace online</span><span class="user-pill">@User.Identity?.Name</span>
                <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="logout-link">Sign out</button></form>
            </div>
        </header>
        <main class="page">
            @if (TempData["Message"] is string message) { <div class="notice success" role="status">@message</div> }
            @if (TempData["Error"] is string error) { <div class="notice warning" role="alert">@error</div> }
            @RenderBody()
        </main>
        <footer class="footer">WORKWISE · INTELLIGENT TASK ALLOCATION <span>ASP.NET Core MVC · Razor Views · MySQL</span></footer>
    </div>
}
else
{
    @RenderBody()
}
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
