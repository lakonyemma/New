@model List<ClientEngagement>
@{
    ViewData["Title"] = "Engagements";
    var management = User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Supervisor);
}
<div class="page-heading"><div><div class="eyebrow">CLIENT DELIVERY</div><h1>Every engagement, organized.</h1><p>Track client work from planning to completion.</p></div>@if(management){<a class="btn primary" asp-action="Create">+ New engagement</a>}</div>
<div class="cards-3">
@foreach(var engagement in Model)
{
    <article class="engagement-card">
        <div class="engagement-head"><span class="icon-tile">◫</span><span class="status inprogress">@engagement.Stage</span></div>
        <div class="small-label">@engagement.ServiceLine.ToUpperInvariant()</div>
        <h2>@engagement.ClientName</h2><p>@engagement.Name</p>
        <div class="engagement-foot"><span>◷ Due @engagement.DueDate.ToString("dd MMM yyyy")</span>@if(management){<a asp-action="Edit" asp-route-id="@engagement.Id">Edit →</a>}</div>
    </article>
}
</div>
@if(Model.Count == 0){<div class="panel blank-inline"><strong>No engagements yet.</strong><p>Use “New engagement” to register your first client project.</p></div>}
