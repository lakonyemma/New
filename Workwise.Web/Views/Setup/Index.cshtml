@model Workwise.Web.Controllers.FirstRunInput
<h1>Set up Workwise</h1>
<p>This page is available only before the first administrator is created. Choose your own administrator password. Obtain the setup token securely from the system operator.</p>
<form asp-controller="Setup" asp-action="Index" method="post">
<div asp-validation-summary="All"></div>
<label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name"/>
<label asp-for="Email"></label><input asp-for="Email" autocomplete="email"/>
<label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password"/>
<label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password"/>
<label asp-for="SetupToken"></label><input asp-for="SetupToken" type="password" autocomplete="off"/>
<button type="submit">Create administrator account</button>
</form>